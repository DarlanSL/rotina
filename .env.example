# Postgres (local via docker compose, ou Neon em produção)
DATABASE_URL="postgresql://rotina:rotina@localhost:5433/rotina"
# Só no Neon/produção: conexão direta (sem "-pooler") usada pelas migrations
# DIRECT_URL=""

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# Cadastro aberto na tela de login ("false" = só contas criadas pelo admin/seed)
AUTH_SIGNUP="true"

# Necessário ao rodar `next start` fora da Vercel (localhost, VPS, Docker)
AUTH_TRUST_HOST="true"
